{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/code", "destination": "/", "permanent": true },
    { "source": "/code/", "destination": "/", "permanent": true },
    { "source": "/code/:path*", "destination": "/:path*", "permanent": true }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
